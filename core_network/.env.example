# ==============================================================================
# Open5GS & Kamailio IMS Testbed Environment Configuration
# ==============================================================================

# Timezone synchronization between Docker host and containers
TZ=UTC

# PLMN Identification (Standard 3GPP Test PLMN)
MCC=001
MNC=01
TAC=1

NETWORK_NAME=Open5GS

# Docker Container Bridge Subnet
TEST_NETWORK=172.22.0.0/24
DOCKER_HOST_IP=172.22.0.1

# EPC Tier IP Addresses (Open5GS)
MONGO_IP=172.22.0.2
HSS_IP=172.22.0.3
PCRF_IP=172.22.0.4
PCRF_BIND_PORT=3873
SGWC_IP=172.22.0.5
SGWU_IP=172.22.0.6
SGWU_ADVERTISE_IP=172.22.0.6
SMF_IP=172.22.0.7
SMF_DNS1=8.8.8.8
SMF_DNS2=8.8.4.4
UPF_IP=172.22.0.8
UPF_ADVERTISE_IP=172.22.0.8
UPF_TUNTAP_MODE=tun
UPF_INTERNET_APN_IF_NAME=ogstun
UPF_IMS_APN_IF_NAME=ogstun2
MME_IP=172.22.0.9

# IMS Tier IP Addresses (Kamailio & RTPEngine)
DNS_IP=172.22.0.15
RTPENGINE_IP=172.22.0.16
MYSQL_IP=172.22.0.17
PYHSS_IP=172.22.0.18
PYHSS_BIND_PORT=3875
ICSCF_IP=172.22.0.19
ICSCF_BIND_PORT=3869
SCSCF_IP=172.22.0.20
SCSCF_BIND_PORT=3870
PCSCF_IP=172.22.0.21
PCSCF_BIND_PORT=3871

# Supporting Services & Telemetry
WEBUI_IP=172.22.0.26
OSMOMSC_IP=172.22.0.31
OSMOHLR_IP=172.22.0.32
SMSC_IP=172.22.0.33
METRICS_IP=172.22.0.36
METRICS_BIND_PORT=9090
GRAFANA_IP=172.22.0.39
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin

# UE Subnets
UE_IPV4_INTERNET=192.168.100.0/24
UE_IPV4_IMS=192.168.101.0/24
MAX_NUM_UE=1024

# Sanitized Sample Subscriber 1
UE1_IMEI=860000000000001
UE1_IMEISV=8600000000000010
UE1_IMSI=001010000000001
UE1_KI=00112233445566778899aabbccddeeff
UE1_OPC=000102030405060708090a0b0c0d0e0f
UE1_AMF=8000

# Sanitized Sample Subscriber 2
